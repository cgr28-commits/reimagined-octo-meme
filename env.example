# Add as GitHub Actions secrets (Settings → Secrets → Actions):
# GOOGLE_PLACES_API_KEY=your_google_api_key
#
# Recommended for numbered UK door addresses when typing a street name:
# GETADDRESS_DOMAIN_TOKEN=dtoken_...   (create at https://getaddress.io — restrict to your domain)
#
# In Google Cloud, restrict the key to HTTP referrers:
#   https://www.myairporttaxini.co.uk/*
#   https://myairporttaxini.co.uk/*
#
# Enable in Google Cloud (APIs & Services → Library):
#   - Places API (New)
# The route map uses OpenStreetMap and does not need Maps Embed API.

# Client-side (GitHub Actions / .env.local for local dev):
# NEXT_PUBLIC_BOOKINGS_API_URL=https://my-airport-taxi-addresses.<your-subdomain>.workers.dev/bookings
# NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your_web3forms_key   (optional email fallback)
# NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=your_google_api_key   (optional direct client lookup)

# Cloudflare Worker secrets (wrangler secret put ...):
# GOOGLE_PLACES_API_KEY=your_google_api_key
# GETADDRESS_API_KEY=your_getaddress_key
# BOOKING_TO_EMAIL=bookings@myairporttaxini.co.uk
# BOOKING_FROM_EMAIL=bookings@myairporttaxini.co.uk
#
# Google Calendar — bookings go to colinrice876@gmail.com by default:
# 1. Create a service account in Google Cloud and enable Google Calendar API.
# 2. Download the JSON key and store the full JSON as GOOGLE_SERVICE_ACCOUNT_JSON.
# 3. In Google Calendar (colinrice876@gmail.com), open Settings → your calendar
#    → Share with specific people → add the service account email
#    (ends with .iam.gserviceaccount.com) with "Make changes to events".
# 4. Optional override: GOOGLE_CALENDAR_ID=colinrice876@gmail.com
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
